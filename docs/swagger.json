{
    "swagger": "2.0",
    "info": {
        "description": "API for PeaceStudio, including picture upload",
        "title": "PeaceStudio API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/result/{id}": {
            "get": {
                "description": "Returns the actual image file once a job's status is Finished",
                "produces": [
                    "image/png"
                ],
                "tags": [
                    "result"
                ],
                "summary": "Fetch the processed picture for a finished job",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job ID returned from the upload response",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "processed image",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "404": {
                        "description": "job not found or not finished yet",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
{
    "swagger": "2.0",
    "info": {
        "description": "API for PeaceStudio, including picture upload",
        "title": "PeaceStudio API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/status/{id}": {
            "get": {
                "description": "Returns the current state of a job: Waiting, Getting worked on, Finished, or Failed",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "status"
                ],
                "summary": "Check the status of an uploaded picture's job",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job ID returned from the upload response",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "job status",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "job not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/upload": {
            "post": {
                "description": "Upload an image file via multipart form (jpg, png, gif, webp only, max 5MB) and choose one action: grayscale, blur, resize, or pixelate",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "upload"
                ],
                "summary": "Upload a picture and apply one action",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Picture to upload",
                        "name": "picture",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Action to apply: grayscale, blur, resize, or pixelate",
                        "name": "action",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "picture uploaded successfully",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "bad request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}